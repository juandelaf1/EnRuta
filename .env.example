# EnRuta - entorno local (no commitear secretos reales)
SKYCAST_URL=http://localhost:8000
ENRUTA_SECRET_KEY=cambiar-en-produccion
# M2M (D5, opcional): ENRUTA_M2M_KEYS=poolar:secret:logistics:evaluate
# ENRUTA_M2M_RATE_LIMIT=120/minute
# ENRUTA_AUDIT_FILE=./logs/enruta-audit.jsonl
# Escalado (opcional): REDIS_URL=redis://localhost:6379/0  (rate limit distribuido; requiere paquete redis)
# Producción: ENRUTA_ENV=production, CORS_ORIGINS explícito, secret manager para ENRUTA_SECRET_KEY/M2M_KEYS
# Docker/PostGIS (perfil pg): POSTGRES_PASSWORD=enruta_dev